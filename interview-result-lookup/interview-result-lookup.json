      "parameters": {
        "jsCode": "const cq = $json.callback_query;\nconst data = cq?.data || '';\nconst id = data.startsWith('sel:') ? data.slice(4) : null;\n\nreturn [\n  {\n    json: {\n      matched_id: id,\n      chat_id: cq?.message?.chat?.id,\n      callback_query_id: cq?.id,\n      query_student_name: '',\n    },\n  },\n];"
      },
