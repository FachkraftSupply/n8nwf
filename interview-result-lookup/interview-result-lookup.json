      "parameters": {
        "jsCode": "const msg = $input.first().json.message;\nconst text = (msg?.text || '').trim();\nconst chatId = msg?.chat?.id;\n\nconst prefix = '/ketqua';\nlet valid = false;\nlet company = '';\nlet student_name = '';\n\nif (text.toLowerCase().startsWith(prefix)) {\n  const rest = text.slice(prefix.length).trim();\n  if (rest) {\n    if (rest.includes('+')) {\n      // Cú pháp: /ketqua Công ty + Tên học sinh\n      const parts = rest.split('+').map((s) => s.trim()).filter(Boolean);\n      if (parts.length >= 2) {\n        company = parts[0];\n        student_name = parts.slice(1).join(' + ');\n        valid = true;\n      }\n    } else {\n      // Cú pháp: /ketqua Tên học sinh (tìm trên toàn bộ công ty)\n      student_name = rest;\n      company = '';\n      valid = true;\n    }\n  }\n}\n\nreturn [\n  {\n    json: {\n      valid,\n      company,\n      student_name,\n      chat_id: chatId,\n      raw_text: text,\n    },\n  },\n];"
      },
