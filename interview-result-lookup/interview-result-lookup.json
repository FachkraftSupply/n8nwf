      "parameters": {
        "jsCode": "const out = $input.first().json;\n\nlet ids = [];\ntry {\n  const parsed = JSON.parse(out.output);\n  ids = Array.isArray(parsed.matches) ? parsed.matches : [];\n} catch (e) {\n  ids = [];\n}\n\nconst prev = $('Rút gọn danh sách candidate').first().json;\nconst candidateMap = new Map(prev.candidates.map((c) => [String(c.id), c]));\n\nconst matches = ids.map((id) => candidateMap.get(String(id))).filter(Boolean);\n\nreturn [\n  {\n    json: {\n      matches,\n      count: matches.length,\n      chat_id: prev.chat_id,\n      query_student_name: prev.query_student_name,\n    },\n  },\n];"
      },
