    {
      "id": "ca9c9ed9-7fdc-4cbe-b7aa-06b424417dbb",
      "name": "Format danh sách ngưỡng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        880
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst chatId = $('Là lệnh /nguong?').first().json.chat_id;\n\nconst byScope = { default: [], company: [], profession: [] };\nfor (const r of rows) {\n  if (byScope[r.scope]) byScope[r.scope].push(r);\n}\n\nconst def = byScope.default[0];\nconst companies = byScope.company.sort((a, b) => String(a.scope_value).localeCompare(String(b.scope_value)));\nconst professions = byScope.profession.sort((a, b) => String(a.scope_value).localeCompare(String(b.scope_value)));\n\nconst lines = [];\nlines.push('*Ngưỡng điểm \"Đạt\" hiện tại*');\nlines.push('');\nlines.push(`Mặc định: *${def ? def.threshold : 6}*`);\n\nif (companies.length) {\n  lines.push('');\n  lines.push('*Theo công ty:*');\n  for (const c of companies) lines.push(`• \\`${c.scope_value}\\` — ${c.threshold}`);\n}\n\nif (professions.length) {\n  lines.push('');\n  lines.push('*Theo nghề:*');\n  for (const p of professions) lines.push(`• \\`${p.scope_value}\\` — ${p.threshold}`);\n}\n\nlines.push('');\nlines.push('Chỉnh ngưỡng tại Supabase (bảng score_thresholds):');\nlines.push('https://supabase.com/dashboard/project/oreodamslizkrmdpvgye/editor');\n\nreturn [{ json: { chat_id: chatId, message: lines.join('\\n') } }];"
      }
    },
