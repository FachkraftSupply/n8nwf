      "id": "e6a258d9-b820-41f1-be1f-8f93499c499a",
      "name": "Supabase: Lấy chi tiết kết quả",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        5072,
        1152
      ],
      "credentials": {
        "supabaseApi": {
          "id": "LLZ2H3Sv9uyj5V1a",
          "name": "Supabase account test tiếng"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $('Supabase: Lấy chi tiết kết quả').first().json;\nconst chatId = $('Chuẩn bị lấy chi tiết').first().json.chat_id;\n\nlet situations = [];\ntry { situations = JSON.parse(r.situations || '[]'); } catch (e) { situations = []; }\n\nconst situationLines = situations\n  .filter((s) => s.answer && !/Chưa hỏi/i.test(s.answer))\n  .map((s) => `• ${s.question}: ${s.answer}`)\n  .join('\\n') || 'Không có';\n\n// Ngưỡng điểm đạt/chưa đạt lấy từ bảng Supabase \"score_thresholds\" (node \"Supabase: Lấy ngưỡng điểm\"),\n// thay cho mảng specialCompanies hardcode trước đây. Ưu tiên khi tra: company > profession > default.\n// Thêm/sửa ngưỡng cho đối tác hoặc nghề mới chỉ cần INSERT/UPDATE 1 dòng trong Supabase, không cần sửa code.\nconst thresholdRows = $input.all().map((i) => i.json);\n\n// Bỏ dấu (umlaut tiếng Đức, dấu tiếng Việt) + lowercase, để so khớp không phụ thuộc cách gõ dấu\nfunction normalize(s) {\n  return String(s || '')\n    .trim()\n    .toLowerCase()\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '');\n}\n\nconst companyCode = String(r.company || '').trim().toLowerCase();\nconst professionNorm = normalize(r.profession);\n\n// company: field sạch, 1 giá trị -> so khớp chính xác\nconst byCompany = thresholdRows.find((t) => t.scope === 'company' && String(t.scope_value || '').trim().toLowerCase() === companyCode);\n\n// profession: field thường bị ghi ghép nhiều nghề trong 1 chuỗi (vd \"Refa/Fachverkäufer/Koch/Bäcker\").\n// Chỉ áp ngưỡng riêng khi profession KHỚP CHÍNH XÁC (sau khi bỏ dấu) với 1 giá trị đã cấu hình -\n// tránh cho nhầm ngưỡng ưu đãi khi ứng viên chỉ liệt kê nghề đó như 1 trong nhiều kỹ năng.\n// Muốn bao phủ thêm biến thể viết khác (vd \"Bäcker/in\", \"Bäckerin\") -> thêm dòng scope_value riêng trong Supabase.\nconst byProfession = thresholdRows.find((t) => t.scope === 'profession' && professionNorm === normalize(t.scope_value));\n\nconst byDefault = thresholdRows.find((t) => t.scope === 'default');\n\n// Fallback 6 nếu bảng score_thresholds trống hoặc chưa có dòng default (an toàn, không sập workflow)\nconst threshold = Number((byCompany || byProfession || byDefault || {}).threshold ?? 6);\nconst finalScore = Number(r.final_score) || 0;\nconst verdict = finalScore >= threshold ? 'Đạt' : 'Chưa đạt';\n\nconst msg = [\n  '*Kết quả phỏng vấn*',\n  `Công ty: ${r.company}`,\n  `Học viên: ${r.student_name}`,\n  `Ngành: ${r.profession}`,\n  `Ngày PV: ${r.interview_date}`,\n  `Giám khảo: ${r.evaluator}`,\n  '',\n  `Điểm: Phát âm ${r.score_pronunciation} | Nghe ${r.score_listening} | Nội dung ${r.score_content} | Tình huống ${r.score_situation} | Thái độ ${r.score_attitude}`,\n  `Tổng điểm: *${r.total_score}* → Điểm cuối: *${r.final_score}*`,\n  `Kết luận: *${verdict}* (ngưỡng đạt: ${threshold})`,\n  '',\n  `Nhận xét phát âm: ${r.detail_pronunciation || '-'}`,\n  `Nhận xét nghe hiểu: ${r.detail_listening || '-'}`,\n  `Nhận xét nội dung: ${r.detail_content || '-'}`,\n  `Thái độ: ${r.detail_attitude || '-'}`,\n  '',\n  `Câu hỏi tình huống đã hỏi:\\n${situationLines}`,\n  '',\n  `Ghi chú: ${r.notes || '-'}`,\n].join('\\n');\n\nreturn [{ json: { chat_id: chatId, message: msg } }];"
      },
