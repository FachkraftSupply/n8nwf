      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items.map((i) => i.json).filter((r) => r && r.id);\n\nconst candidates = rows.map((r) => ({\n  id: r.id,\n  student_name: r.student_name,\n  company: r.company,\n  interview_date: r.interview_date,\n  verdict: r.verdict,\n}));\n\nconst parsed = $('Parse lệnh /ketqua').first().json;\n\nreturn [\n  {\n    json: {\n      candidates,\n      count: candidates.length,\n      query_student_name: parsed.student_name,\n      query_company: parsed.company,\n      chat_id: parsed.chat_id,\n    },\n  },\n];"
      },
