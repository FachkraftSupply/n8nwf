        "jsCode": "const item = $input.first().json; // { matches, count, chat_id, query_student_name }\n\nconst inline_keyboard = item.matches.map((m) => ([\n  {\n    text: `${m.company} - ${m.student_name}${m.interview_date ? ' (' + m.interview_date + ')' : ''}`,\n    callback_data: `sel:${m.id}`\n  }\n]));\n\nreturn [{\n  json: {\n    chat_id: item.chat_id,\n    text: `Tìm thấy ${item.count} học sinh khớp với \"${item.query_student_name}\". Vui lòng chọn:`,\n    reply_markup: JSON.stringify({ inline_keyboard })\n  }\n}];"
