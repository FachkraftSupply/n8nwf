    {
      "parameters": {
        "jsCode": "// ╔═════════════════════════════════════════╗\n// ║  GW-03: Lệnh -> bot_key + check quyền     ║\n// ╚══════════════════════════════════════════╝\nconst cfg = $('⚙️ Config').first().json;\nconst env = $input.first().json;\n\n// Callback (bam nut) khong co dang \"/lenh\" nen env.command luon null - nhan dien qua prefix\n// cua callback_data thay vi COMMAND_MAP. Them prefix moi vao day khi sub-workflow can nhan callback.\nfunction resolveBotKeyForCallback(data) {\n  if (!data) return null;\n  if (data.startsWith('chitiet_') || data.startsWith('sync_') || data.startsWith('view_file:')) {\n    return 'telebot_main';\n  }\n  return null;\n}\n\nlet bot;\nif (env.command) {\n  bot = cfg.COMMAND_MAP[env.command] || null;\n} else if (env.kind === 'callback') {\n  bot = resolveBotKeyForCallback(env.callback?.data) || cfg.DEFAULT_BOT;\n} else {\n  bot = cfg.DEFAULT_BOT;\n}\n\nlet route;\nif (!bot)                                route = 'unknown';\nelse if (!env.auth.bots.includes(bot))   route = 'no_permission';\nelse                                     route = bot;\n\nreturn [{ json: { ...env, bot_key: bot, route } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
      "id": "b6875384-d409-4ade-803a-20b5b0515dcd",
      "name": "GW-03 Router"
    },
