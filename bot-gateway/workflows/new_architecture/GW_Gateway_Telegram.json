    {
      "parameters": {
        "jsCode": "// ╔═════════════════════════════════════════╗\n// ║  CONFIG - sửa 1 chỗ, dùng toàn workflow    ║\n// ╚══════════════════════════════════════════╝\nreturn [{ json: {\n  ADMIN_CHAT_ID: '975005174',\n  AVAILABLE_BOTS: ['telebot_main', 'help_bot', 'crawl_bot', 'image_bot'],\n  // map lệnh -> bot_key\n  COMMAND_MAP: { task:'telebot_main', t:'telebot_main', start:'telebot_main', help:'telebot_main',\n                 ask:'help_bot', sum:'crawl_bot', crawl:'crawl_bot',\n                 xoanen:'image_bot', tomtat:'image_bot' },\n  // Luu y: /sync, /sync_status, /db_status KHONG con o day nua - da chuyen sang\n  // Telebot_Admin_System.json (Trigger rieng tren @elite_n8n_system_bot, khong qua Gateway)\n  DEFAULT_BOT: 'help_bot'   // tin nhắn tự do (không lệnh) route về đâu\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ],
      "id": "ead42395-b1a6-400f-8084-cee1446d01d9",
      "name": "⚙️ Config"
    },
    {
      "parameters": {
        "jsCode": "// ╔═════════════════════════════════════════╗\n// ║  GW-01: Chuẩn hóa update -> Envelope       ║\n// ║  request_id = correlation ID để debug      ║\n// ╚══════════════════════════════════════════╝\nconst upd = $('Telegram Trigger Gateway').first().json;\nconst reqId = `req_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;\n\nlet kind, m = null, user, chat, text = '', callback = null;\n\nif (upd.callback_query) {\n  kind = 'callback';\n  const cq = upd.callback_query;\n  user = cq.from;\n  chat = cq.message.chat;\n  callback = { id: cq.id, data: cq.data || '', message_id: cq.message.message_id };\n  text = cq.data || '';\n} else {\n  m = upd.message || upd.edited_message;\n  if (!m) return [];              // update lạ -> bỏ qua\n  kind = 'message';\n  user = m.from;\n  chat = m.chat;\n  text = m.text || m.caption || '';\n}\n\nconst command = (text.match(/^\\/(\\w+)/) || [])[1] || null;\n\nreturn [{ json: {\n  request_id: reqId,\n  platform: 'telegram',\n  kind,                                   // message | callback\n  user_id: String(user.id),\n  username: user.username || '',\n  display_name: [user.first_name, user.last_name].filter(Boolean).join(' '),\n  chat_id: String(chat.id),\n  message_id: m ? m.message_id : (callback ? callback.message_id : null), // de reply dung group/topic\n  text,\n  command,\n  callback,\n  has_media: !!(m && (m.photo || m.document || m.video)),\n  ts: new Date().toISOString(),\n  raw: upd\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        0
      ],
      "id": "a208b29c-86da-4820-9dfe-818077154873",
      "name": "GW-01 Envelope"
    },
