        "query": "SELECT u.status, u.role, COALESCE(array_agg(p.bot_key) FILTER (WHERE p.bot_key IS NOT NULL), '{}') AS bots FROM gateway.bot_users u LEFT JOIN gateway.bot_permissions p ON p.platform = u.platform AND p.user_id = u.user_id WHERE u.platform = 'telegram' AND u.user_id = $1 GROUP BY u.status, u.role",
