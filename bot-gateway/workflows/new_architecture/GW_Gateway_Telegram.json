    {
      "parameters": {
        "jsCode": "// \u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\n// \u2551  GW-03: L\u1ec7nh -> bot_key + check quy\u1ec1n     \u2551\n// \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\nconst cfg = $('\u2699\ufe0f Config').first().json;\nconst env = $input.first().json;\n\nconst bot = env.command ? (cfg.COMMAND_MAP[env.command] || null) : cfg.DEFAULT_BOT;\n\nlet route;\nif (!bot)                                route = 'unknown';\nelse if (!env.auth.bots.includes(bot))   route = 'no_permission';\nelse                                     route = bot;\n\nreturn [{ json: { ...env, bot_key: bot, route } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        200
      ],
      "id": "b6875384-d409-4ade-803a-20b5b0515dcd",
      "name": "GW-03 Router"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
