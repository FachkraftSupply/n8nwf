    {
      "parameters": {
        "jsCode": "\n// Chi cho phep whitelist cot duoc update (tranh SQL injection qua ten cot dong)\nconst ALLOWED_COLUMNS = ['status', 'name', 'description', 'phu_trach', 'dkpv', 'pvtc',\n  'vfs', 'planbay', 'ngaybay', 'color'];\nconst u = $json;\nif (!ALLOWED_COLUMNS.includes(u.column)) {\n  return []; // bo qua field khong trong whitelist, khong lam gi\n}\nreturn [{ json: { ...u, taskId: $('Phân tích Webhook Payload').first().json.taskId } }];\n"
      },
