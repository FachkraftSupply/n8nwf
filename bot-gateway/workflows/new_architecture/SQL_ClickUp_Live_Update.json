      "id": "ae588eef-bd8c-490e-b95f-a207448fa04b",
      "name": "ClickUp Trigger (Live)",
      "type": "n8n-nodes-base.clickUpTrigger",
      "typeVersion": 1,
      "position": [
        -3600,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Phan tich payload webhook ClickUp: xac dinh day la su kien \"field thuong doi\" hay \"comment\"\nconst body = $json;\nconst event = body.event; // taskUpdated | taskCommentPosted | taskCommentUpdated\nconst taskId = body.task_id;\nconst historyItems = body.history_items || [];\n\nconst isCommentEvent = event === 'taskCommentPosted' || event === 'taskCommentUpdated';\n\n// Map ten field ClickUp (trong history_items) -> ten cot Postgres.\n// CAN KIEM TRA LAI cho khop ten field that (field trong webhook thuong la ten ky thuat,\n// vi du \"status\", \"content\" (mo ta), \"name\"... con custom field se co field=\"1234-uuid\"\n// kem theo history_item.field co the la \"custom_field\" va can doc them 'custom_field' object\n// - phan nay se can tinh chinh sau khi thay 1 payload that.\nconst FIELD_TO_COLUMN = {\n  status: 'status',\n  name: 'name',\n  content: 'description',\n};\n\nlet updates = []; // [{ column, newValue, changedBy, fieldLabel }]\n\nif (!isCommentEvent) {\n  for (const h of historyItems) {\n    const col = FIELD_TO_COLUMN[h.field];\n    if (!col) continue; // bo qua field khong theo doi (assignee, priority... neu chua map)\n    let after = h.after;\n    if (after && typeof after === 'object') after = after.status || after.name || JSON.stringify(after);\n    updates.push({\n      column: col,\n      newValue: after,\n      changedBy: h.user?.username || 'không rõ',\n      fieldLabel: h.field,\n    });\n  }\n}\n\nreturn [{\n  json: {\n    taskId, event, isCommentEvent,\n    updates,\n    rawHistoryItems: historyItems,\n  }\n}];\n"
      },
      "id": "50276138-bda2-48c8-9048-baf8238fb7be",
      "name": "Phân tích Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3360,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
