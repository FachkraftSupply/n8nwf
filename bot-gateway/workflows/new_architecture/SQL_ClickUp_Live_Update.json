        "operation": "executeQuery",
        "query": "UPDATE clickup.tasks SET onedrive_link = COALESCE(NULLIF($1, ''), onedrive_link), youtube_link = COALESCE(NULLIF($2, ''), youtube_link), synced_at = now() WHERE id = $3 RETURNING id, name, url;",
        "options": {
          "queryReplacement": "={{ [$json.onedriveLink || '', $json.youtubeLink || '', $json.taskId] }}"
        }
      },
