    {
      "parameters": {
        "jsCode": "\nconst pgRow = $json;\nconst meta = $('Lọc cột hợp lệ').first().json;\nconst admin = $('Lay Admin Chat ID (F2)').first().json;\n\nconst FIELD_LABELS = {\"status\": \"Trạng thái\", \"name\": \"Tên task\", \"description\": \"Mô tả\", \"phu_trach\": \"Phụ trách\", \"dkpv\": \"DKPV\", \"pvtc\": \"PVTC\", \"vfs\": \"VFS\", \"planbay\": \"Plan bay\", \"ngaybay\": \"Ngày bay\", \"color\": \"Color\"};\nconst label = FIELD_LABELS[meta.column] || meta.column;\nconst now = new Date();\n\nconst text = `🔄 <b>Thông báo CẬP NHẬT Task</b>\\n\\n` +\n  `🔧 Thay đổi:\\n` +\n  `📝 Trường \"${label}\" được cập nhật bởi ${meta.changedBy}\\n` +\n  `✅ Giá trị mới: ${meta.newValue ?? '—'}\\n\\n` +\n  `📦 Thông tin:\\n` +\n  `🆔 ID: ${pgRow.id}\\n` +\n  `📌 Tên: ${pgRow.name || '—'}\\n` +\n  `🔗 Link: ${pgRow.url || '—'}\\n` +\n  `🕒 Cập nhật lúc: ${now.toLocaleString('vi-VN')} #task_updated`;\n\nreturn [{ json: { chatId: admin.admin_chat_id, text } }];\n"
      },
      "id": "0f8afba0-6f0c-490d-8908-844a8b4eef9e",
