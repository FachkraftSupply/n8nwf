        "jsCode": "// Adapter Gateway: chuan hoa Message Envelope (spec ARCHITECTURE.md muc 3)\n// thanh shape update Telegram cu ma Code1 (parse intent) dang ky vong.\n// Giu nguyen toan bo field envelope goc (request_id, platform, auth, bot_key,\n// route, callback, raw...) de khong mat Correlation ID va context auth khi\n// di tiep xuong AI Agent. Chi them key 'message' gia lap Telegram update.\nconst items = $input.all();\nreturn items.map(it => {\n  const env = it.json ?? {};\n  return {\n    json: {\n      ...env,\n      message: {\n        text: env.text || '',\n        chat: { id: env.chat_id },\n        from: { id: env.user_id, username: env.username }\n      }\n    }\n  };\n});\n"
