    {
      "parameters": {
        "jsCode": "// n8n Code node (JavaScript)\n// Mục tiêu: Giữ nguyên mọi key gốc. Chỉ bổ sung key phân tích.\n// Nếu key bổ sung trùng tên với key gốc -> đưa vào namespace `_parsed` để tránh overwrite.\n\nfunction parseIntent(t) {\n  const s = (t || '').toLowerCase().trim();\n  if (!s) return { intent: 'help' };\n  if (s.startsWith('/help') || s === 'help') return { intent: 'help' };\n  if (s.startsWith('/menu')) return { intent: 'menu' };\n  if (s.startsWith('/groups') || s.includes('nhóm')) return { intent: 'groups', query: s.replace('/groups', '').trim() };\n  if (s.startsWith('/wiki ')) return { intent: 'wiki', query: s.replace('/wiki', '').trim() };\n  if (s.startsWith('/where ')) return { intent: 'where', query: s.replace('/where', '').trim() };\n  if (s.startsWith('/task')) return { intent: 'task' };\n  if (s.startsWith('/bot')) return { intent: 'bot' };\n  return { intent: 'free_text', query: s };\n}\n\nfunction buildOutput(original) {\n  // clone sâu để không đụng vào tham chiếu gốc\n  const out = JSON.parse(JSON.stringify(original || {}));\n\n  const msg = out.message || {};\n  const text = (msg.text || '').trim();\n  const p = parseIntent(text);\n\n  const additions = {\n    chat_id: msg.chat?.id,\n    user_id: msg.from?.id,\n    username: msg.from?.username,\n    text,\n    intent: p.intent,\n    query: p.query || '',\n  };\n\n  // Thêm an toàn: nếu key đã tồn tại ở root -> đưa vào _parsed\n  let hasConflicts = false;\n  const parsedNamespace = {};\n\n  for (const [k, v] of Object.entries(additions)) {\n    if (Object.prototype.hasOwnProperty.call(out, k)) {\n      hasConflicts = true;\n      parsedNamespace[k] = v;\n    } else {\n      out[k] = v; // thêm trực tiếp vì không trùng key\n    }\n  }\n\n  if (hasConflicts) {\n    // Nếu _parsed đã tồn tại, merge cẩn thận để không mất dữ liệu cũ\n    if (typeof out._parsed !== 'object' || out._parsed === null) {\n      out._parsed = {};\n    }\n    for (const [k, v] of Object.entries(parsedNamespace)) {\n      // chỉ thêm nếu chưa có trong _parsed để tránh overwrite\n      if (!Object.prototype.hasOwnProperty.call(out._parsed, k)) {\n        out._parsed[k] = v;\n      }\n    }\n  }\n\n  return out;\n}\n\n// Hỗ trợ nhiều item từ upstream\nconst items = $input.all();\nconst results = items.map(it => {\n  const original = it.json ?? {};\n  const merged = buildOutput(original);\n  return { json: merged };\n});\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
