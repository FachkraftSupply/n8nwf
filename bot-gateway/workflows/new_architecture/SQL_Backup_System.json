    {
      "parameters": {
        "jsCode": "\nconst tasks = $('Query Tasks').all().map(i => i.json);\nconst taskLinks = $('Query Task Links').all().map(i => i.json);\nconst syncTargets = $('Query Sync Targets (Backup)').all().map(i => i.json);\n\nconst backup = {\n  backup_at: new Date().toISOString(),\n  tables: {\n    'clickup.tasks': tasks,\n    'clickup.task_links': taskLinks,\n    'clickup.sync_targets': syncTargets,\n  }\n};\nreturn [{ json: backup }];\n"
      },
